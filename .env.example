# ==============================================================================
# PIPO 4 ASES - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# IMPORTANTE DE SEGURIDAD (DEVSECOPS):
# 1. NUNCA coloque llaves privadas, tokens de API sensibles ni cadenas de conexión 
#    a bases de datos en este ni en ningún archivo con prefijo VITE_*.
# 2. Las variables con prefijo VITE_* son empaquetadas directamente dentro del bundle 
#    JavaScript que se envía al navegador del cliente y son PÚBLICAS para cualquiera.
# 3. Para credenciales privadas o secretas, utilice funciones serverless, backend proxy o 
#    gestores de secretos en la nube (Vercel Secrets, Netlify Environment Variables, etc.).
# ==============================================================================

# Nombre de la aplicación
VITE_APP_TITLE="PIPO 4 ASES - Distribuidora Digital Mayorista"

# Número oficial de atención por WhatsApp (Formato internacional sin +)
VITE_WHATSAPP_NUMBER="5493815891843"

# URL base pública de la API (si aplica en producción)
# VITE_API_BASE_URL="https://api.tudominio.com/v1"

# Modo del entorno (development / production)
# VITE_APP_ENV="production"
